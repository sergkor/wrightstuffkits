NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-sandbox-client-id

# Etsy Open API v3 (scripts/etsy/*, local only — never needed by the Next.js build)
# 1. Create an app at https://www.etsy.com/developers/your-apps and add
#    http://localhost:3003/callback as a Callback URL. Paste the keystring and shared secret here.
ETSY_API_KEY=your-etsy-keystring
ETSY_SHARED_SECRET=your-etsy-shared-secret
# 2. `npm run etsy:auth`, then `npm run etsy:lookup` prints the IDs below.
ETSY_TAXONOMY_ID=
ETSY_SHIPPING_PROFILE_ID=
ETSY_RETURN_POLICY_ID=
# Optional: force one processing profile ID; by default the script creates/reuses them per listing.
# ETSY_READINESS_STATE_ID=
# Optional overrides
# ETSY_SHOP_ID=
# ETSY_REDIRECT_PORT=3003
